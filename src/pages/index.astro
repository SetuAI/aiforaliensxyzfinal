---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Icons from '../components/Icons.astro';
import { site } from '../site.ts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latest = posts.slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="hero-eyebrow">Engineering &middot; AI Systems &middot; Production</p>
      <h1 class="hero-title">AI for<br /><em>Aliens</em></h1>
      <div class="social-row">
        <a class="social-link" href={site.linkedin} target="_blank" rel="noopener">
          <Icons name="linkedin" /> LinkedIn
        </a>
        <a class="social-link" href={site.github} target="_blank" rel="noopener">
          <Icons name="github" /> GitHub
        </a>
        <a class="social-link" href={site.youtube} target="_blank" rel="noopener">
          <Icons name="youtube" /> YouTube
        </a>
        <a class="social-link" href={site.scholar} target="_blank" rel="noopener">
          <Icons name="scholar" /> Papers
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="writing">
    <div class="wrap">
      <p class="section-label">Writing</p>
      <PostList posts={latest} />
      <a class="view-all" href="/posts/">All posts &rarr;</a>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap">
      <p class="section-label">About</p>
      <div class="about-grid">
        <div class="about-bio">
          <p>I'm Chirantan Lonkar &mdash; Chiru &mdash; founder of <a href={site.company} target="_blank" rel="noopener">Tarka Upskilling</a>, an enterprise AI training company based in Mumbai.</p>
          <p>I design and deliver AI training programmes for engineering teams, financial institutions, and technology organisations across India and internationally.</p>
          <p>I write here to think out loud about what's actually working in production AI systems.</p>
        </div>
        <div class="about-stats">
          <div class="stat">
            <div class="stat-number">7,000+</div>
            <div class="stat-label">professionals trained</div>
          </div>
          <div class="stat">
            <div class="stat-number">50+</div>
            <div class="stat-label">organisations across 9+ countries</div>
          </div>
          <div class="stat">
            <div class="stat-number">9 yrs</div>
            <div class="stat-label">enterprise AI training</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
